{
  "model_name": "Qwen/Qwen3-VL-8B-Instruct",
  "sft_adapter": "checkpoints/mock_heads/final_adapter",
  "sft_heads_path": "checkpoints/mock_heads/final_adapter/classification_heads.pt",
  "train_manifest": "data/manifests/mock_train.jsonl",
  "eval_manifest": "data/manifests/mock_eval.jsonl",
  "output_dir": "checkpoints/mock_grpo",
  "data_root": "data",
  "system_prompt": "workspace/system_prompt.md",
  "category_keywords": "workspace/category_keywords.json",
  "categories": [
    "entailment",
    "neutral",
    "contradiction"
  ],
  "num_categories": 3,
  "category_ignore_on_negative": false,
  "reward": {
    "alpha": 0.2,
    "beta": 1.0,
    "gamma": 1.0,
    "delta": 0.5,
    "dict_weight": 0.5,
    "gt_weight": 0.5,
    "min_format_words": 8
  },
  "group_size": 4,
  "max_new_tokens": 128,
  "temperature": 0.8,
  "kl_beta": 0.04,
  "head_ce_alpha": 0.1,
  "head_ce_beta": 0.1,
  "learning_rate": 5e-6,
  "head_learning_rate": 1e-5,
  "batch_size": 1,
  "grad_accum": 4,
  "max_steps": 50,
  "logging_steps": 5,
  "save_steps": 25,
  "seed": 7
}
